---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { BOOKS, SITE } from '../data/site';

const bookSchemas = BOOKS.map((book) => ({
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: 'https://madisonilia.com',
  },
  isPartOf: {
    '@type': 'BookSeries',
    name: book.series,
  },
  position: book.bookNumber,
  ...(book.year ? { datePublished: book.year } : {}),
  ...(book.coverImage ? { image: `https://madisonilia.com${book.coverImage}` } : {}),
  url: book.amazonUrl,
  sameAs: [book.amazonUrl, ...(book.goodreadsUrl ? [book.goodreadsUrl] : [])],
}));
---

<BaseLayout
  title={`Novels — ${SITE.author}`}
  description="Current and future novels by Madison Ilia, including Navigating Justice: The Crow and Blurred Alliances."
  activePage="novels"
  structuredData={bookSchemas}
>
  <section class="section section-dark">
    <div class="container">
      <h1 class="page-title">Current and Future <span class="accent">Novels</span></h1>

      <div class="books-list">
        {BOOKS.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    color: #ffffff;
    margin-bottom: 2.25rem;
  }

  .accent {
    color: var(--accent-gold);
  }

  .books-list {
    display: grid;
    gap: 2.5rem;
  }
</style>
