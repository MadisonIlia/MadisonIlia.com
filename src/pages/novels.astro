---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { BOOKS, SITE } from '../data/site';

const bookSchemas = BOOKS.map((book) => ({
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: 'https://madisonilia.com',
  },
  isPartOf: {
    '@type': 'BookSeries',
    name: book.series,
  },
  position: book.bookNumber,
  ...(book.year ? { datePublished: book.year } : {}),
  ...(book.coverImage ? { image: `https://madisonilia.com${book.coverImage}` } : {}),
  url: book.amazonUrl,
  sameAs: [book.amazonUrl, ...(book.goodreadsUrl ? [book.goodreadsUrl] : [])],
}));
---

<BaseLayout
  title={`Novels — ${SITE.author}`}
  description="Current and future novels by Madison Ilia, including Navigating Justice: The Crow and Blurred Alliances."
  activePage="novels"
  structuredData={bookSchemas}
>
  <section class="section section-dark">
    <div class="container">
      <h1 class="page-title">Current and Future <span class="accent">Novels</span></h1>

      <div class="books-list">
        {
          BOOKS.map((book, index) => (
            <BookCard book={book} reverse={index % 2 === 1} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-parchment">
    <div class="container next-book-box">
      <div>
        <h2>Subscribe to my newsletter</h2>
        <p>
          Sign up for release updates, behind-the-scenes news, and exclusive content for email
          subscribers.
        </p>
      </div>
      <NewsletterForm variant="light" idPrefix="novels-newsletter" />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    color: #ffffff;
    margin-bottom: 2.25rem;
  }

  .accent {
    color: var(--accent-gold);
  }

  .books-list {
    display: grid;
    gap: 2.5rem;
  }

  .next-book-box {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .next-book-box h2 {
    font-size: clamp(1.9rem, 3.5vw, 2.5rem);
    margin-bottom: 0.65rem;
  }

  .next-book-box p {
    color: var(--text-muted-dark);
    margin: 0;
  }

  @media (max-width: 820px) {
    .next-book-box {
      grid-template-columns: 1fr;
    }
  }
</style>
