---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { BOOKS } from '../data/site';

const latestBook = BOOKS.find((b) => b.isNew) ?? BOOKS[BOOKS.length - 1];
---

<BaseLayout activePage="home">
  <section class="hero section-dark">
    <img
      src="/images/the-crow-banner.jpg"
      alt="Navigating Justice: The Crow by Madison Ilia"
      width="2000"
      height="1333"
      fetchpriority="high"
      class="hero-bg"
    />
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="container">
      <div class="hero-content">
        <h1>Welcome!</h1>
        <p class="hero-lead">
          I’m so glad you’re here! Both books in my <em>Navigating Justice</em> series,{' '}
          <em>The Crow</em> and <em>Blurred Alliances</em>, are available now on Amazon.
        </p>
        <div class="hero-actions">
          <a
            href={latestBook.amazonUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Order Blurred Alliances
          </a>
          <a href="/novels.html" class="btn btn-outline-light">
            Current and Future Novels
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark series-section">
    <div class="container">
      <div class="series-header">
        <h2>The <span class="accent">Navigating Justice</span> Series</h2>
        <a href="/novels.html" class="series-link">Read full synopses &rarr;</a>
      </div>

      <div class="series-grid">
        {
          BOOKS.map((book) => (
              <article class="series-card">
                <a href="/novels.html" class="series-cover-link">
                  <img
                    src={book.coverImage}
                    alt={book.coverAlt ?? book.title}
                    width="400"
                    height="600"
                    loading="lazy"
                    class="series-cover"
                  />
                </a>
                <div class="series-card-body">
                  <div class="series-meta">
                    <span class="series-num">
                      Book {book.bookNumber}
                      {book.year ? ` · ${book.year}` : ''}
                    </span>
                    {book.isNew && <span class="badge">New</span>}
                  </div>
                  <h3>{book.title}</h3>
                  <p class="series-tagline">{book.tagline}</p>
                  <div class="series-actions">
                    <a
                      href={book.amazonUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-primary"
                    >
                      Order on Amazon
                    </a>
                    <a href="/novels.html" class="btn btn-outline-light">
                      Synopsis
                    </a>
                  </div>
                </div>
              </article>
            ))
        }
      </div>
    </div>
  </section>

  <section class="quote-band section-slate">
    <div class="container">
      <blockquote class="home-quote">
        <p>
          “Strength and courage are not present with the absence of fear. Merely that people and
          situations are and will be more important than fear alone. Through our weakest link we
          are strong. By love we possess our greatest weapon.”
        </p>
        <footer>— Madison Ilia</footer>
      </blockquote>
    </div>
  </section>

  <section class="section section-parchment">
    <div class="container about-teaser">
      <div class="about-teaser-media">
        <img
          src="/images/bio-alt.jpg"
          alt="Madison Ilia"
          width="800"
          height="1000"
          loading="lazy"
          class="portrait-img"
        />
      </div>
      <div class="about-teaser-body">
        <h2>More about <span class="accent-dark">me</span></h2>
        <p>
          I suppose a formal introduction is appropriate. I’m Madison Ilia. I live in a
          middle-of-nowhere town where the sun shines once a week if we’re lucky, we have more rocks
          than grass, and the trees have taken over; but it’s okay, we hold our own when we need to
          cut it.
        </p>
        <a href="/about.html" class="btn btn-outline-dark">Read my full story</a>
      </div>
    </div>
  </section>

  <section class="section section-dark newsletter-band">
    <div class="container newsletter-wrap">
      <div class="newsletter-copy">
        <h2>Subscribe to my <span class="accent">newsletter</span></h2>
        <p>
          Sign up for release updates, behind-the-scenes news, and exclusive content for email
          subscribers.
        </p>
      </div>
      <NewsletterForm variant="dark" idPrefix="home-newsletter" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: clamp(480px, 72vh, 660px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 4.5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(11, 17, 32, 0.92) 0%,
      rgba(11, 17, 32, 0.78) 52%,
      rgba(11, 17, 32, 0.45) 100%
    );
  }

  .hero > .container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 40rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 5.5vw, 4.2rem);
    color: #ffffff;
    margin-bottom: 1.1rem;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: #e2e8f0;
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .accent {
    color: var(--accent-gold);
  }

  .accent-dark {
    color: #9a6b3b;
  }

  .series-section {
    background:
      radial-gradient(circle at 50% 0%, rgba(212, 163, 115, 0.08), transparent 55%),
      var(--bg-night);
  }

  .series-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .series-header h2 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    color: #ffffff;
    margin: 0;
  }

  .series-link {
    color: var(--accent-gold);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .series-link:hover {
    text-decoration: underline;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .series-card {
    display: grid;
    grid-template-columns: minmax(130px, 180px) 1fr;
    gap: 1.5rem;
    align-items: stretch;
    background-color: var(--bg-slate);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .series-card-body {
    display: flex;
    flex-direction: column;
  }

  .series-cover-link {
    display: block;
  }

  .series-cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease;
  }

  .series-cover-link:hover .series-cover {
    transform: translateY(-3px);
  }

  .series-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.45rem;
  }

  .series-num {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .series-card-body h3 {
    font-size: 1.85rem;
    color: #ffffff;
    margin-bottom: 0.6rem;
  }

  .series-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.45;
    color: #cbd5e1;
    margin: 0 0 1.25rem;
  }

  .series-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
  }

  .series-actions .btn {
    padding: 0.65rem 1.15rem;
    font-size: 0.9rem;
  }

  .quote-band {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
  }

  .home-quote {
    margin: 0 auto;
    max-width: 46rem;
    text-align: center;
  }

  .home-quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    line-height: 1.45;
    color: var(--text-light);
    margin: 0 0 1rem;
  }

  .home-quote footer {
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    color: var(--accent-gold);
  }

  .about-teaser {
    display: grid;
    grid-template-columns: minmax(220px, 340px) 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .portrait-img {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
  }

  .about-teaser-body h2 {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    margin-bottom: 1rem;
  }

  .about-teaser-body p {
    color: var(--text-muted-dark);
    margin-bottom: 1.75rem;
    max-width: 54ch;
  }

  .newsletter-band {
    border-top: 1px solid var(--border-dark);
  }

  .newsletter-wrap {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .newsletter-copy h2 {
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .newsletter-copy p {
    color: var(--text-muted-light);
    margin: 0;
  }

  @media (max-width: 960px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(11, 17, 32, 0.86) 0%,
        rgba(11, 17, 32, 0.88) 100%
      );
    }

    .about-teaser,
    .newsletter-wrap {
      grid-template-columns: 1fr;
    }

    .about-teaser-media {
      max-width: 300px;
    }
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .series-card {
      grid-template-columns: 1fr;
    }

    .series-cover-link {
      max-width: 200px;
      margin-inline: auto;
    }
  }
</style>
