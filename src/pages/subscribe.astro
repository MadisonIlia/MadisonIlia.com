---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`Subscribe — ${SITE.author}`}
  description="Subscribe to Madison Ilia's newsletter for release dates, updates, and subscriber-only content."
  activePage="subscribe"
>
  <section class="section section-parchment">
    <div class="container subscribe-card">
      <h1>Subscribe to my <span class="accent-dark">newsletter</span></h1>
      <p class="subscribe-lead">
        Receive release dates, behind-the-scenes updates, and exclusive content only available to
        email subscribers.
      </p>
      <NewsletterForm variant="light" idPrefix="subscribe-page" />
    </div>
  </section>
</BaseLayout>

<style>
  .subscribe-card {
    max-width: 720px;
    background-color: var(--bg-paper);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow-card);
  }

  .subscribe-card h1 {
    font-size: clamp(2.1rem, 4vw, 2.8rem);
    margin-bottom: 0.5rem;
  }

  .accent-dark {
    color: #9a6b3b;
  }

  .subscribe-lead {
    color: var(--text-muted-dark);
    margin-bottom: 2rem;
    max-width: 54ch;
  }
</style>
