---
import type { Book } from '../data/site';

interface Props {
  book: Book;
  compact?: boolean;
  reverse?: boolean;
}

const { book, compact = false, reverse = false } = Astro.props;
---

<article class:list={['book-card', { 'book-card--compact': compact, 'book-card--reverse': reverse }]}>
  <div class="book-cover-wrap">
    {
      book.coverImage ? (
        <img
          src={book.coverImage}
          alt={book.coverAlt ?? book.title}
          width="400"
          height="600"
          loading="lazy"
          class="book-cover-img"
        />
      ) : (
        <div class="book-cover-placeholder" aria-label={`${book.title} — ${book.series} Book ${book.bookNumber}`}>
          <span class="cover-series">{book.series} Series</span>
          <span class="cover-number">Book {book.bookNumber}</span>
          <h3 class="cover-title">{book.title}</h3>
          <span class="cover-author">Madison Ilia</span>
        </div>
      )
    }
  </div>

  <div class="book-body">
    <div class="book-meta">
      <span class="book-series-label">
        {book.series} &middot; Book {book.bookNumber}
        {book.year ? ` (${book.year})` : ''}
      </span>
      {book.isNew && <span class="badge">Latest Release</span>}
    </div>

    <h2 class="book-title">{book.title}</h2>
    <p class="book-tagline">{book.tagline}</p>

    {
      !compact &&
        book.description.map((paragraph) => <p class="book-description">{paragraph}</p>)
    }

    <div class="book-actions">
      <a
        href={book.amazonUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Order on Amazon
      </a>
      {
        book.goodreadsUrl && (
          <a
            href={book.goodreadsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-light"
          >
            View on Goodreads
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .book-card {
    display: grid;
    grid-template-columns: minmax(220px, 300px) 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    background-color: var(--bg-slate);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    box-shadow: var(--shadow-lg);
    color: var(--text-light);
  }

  .book-card--reverse .book-cover-wrap {
    order: 2;
  }

  .book-card--compact {
    grid-template-columns: minmax(150px, 200px) 1fr;
    gap: 1.75rem;
    padding: 1.75rem;
    align-items: start;
  }

  .book-cover-img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.55);
  }

  .book-cover-placeholder {
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: var(--radius-md);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
    background:
      radial-gradient(circle at 25% 20%, rgba(148, 163, 184, 0.2), transparent 55%),
      radial-gradient(circle at 80% 75%, rgba(212, 163, 115, 0.22), transparent 50%),
      linear-gradient(165deg, #0f172a 0%, #1e293b 55%, #090d16 100%);
    border: 1px solid rgba(212, 163, 115, 0.35);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.55);
  }

  .cover-series {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .cover-number {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted-light);
    margin-top: -0.5rem;
  }

  .cover-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    color: #ffffff;
    margin: auto 0;
    line-height: 1.1;
  }

  .cover-author {
    font-size: 0.82rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .book-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .book-series-label {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .book-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .book-card--compact .book-title {
    font-size: clamp(1.65rem, 2.5vw, 2rem);
  }

  .book-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.45;
    color: #e2e8f0;
    margin-bottom: 1.25rem;
  }

  .book-description {
    color: var(--text-muted-light);
    margin-bottom: 1rem;
  }

  .book-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 780px) {
    .book-card,
    .book-card--compact {
      grid-template-columns: 1fr;
    }

    .book-card--reverse .book-cover-wrap {
      order: 0;
    }

    .book-cover-wrap {
      max-width: 280px;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
