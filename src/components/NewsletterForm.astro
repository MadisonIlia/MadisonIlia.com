---
import { SITE } from '../data/site';

interface Props {
  variant?: 'dark' | 'light';
  idPrefix?: string;
}

const { variant = 'dark', idPrefix = 'newsletter' } = Astro.props;
const emailId = `${idPrefix}-email`;
const emailHintId = `${idPrefix}-email-hint`;
const emailErrorId = `${idPrefix}-email-error`;
const fnameId = `${idPrefix}-fname`;
---

<form
  action={SITE.mailchimp.actionUrl}
  method="post"
  target="_blank"
  rel="noopener noreferrer"
  class:list={['newsletter-form', `newsletter-form--${variant}`]}
  data-validated-form
>
  <div class="form-grid">
    <div class="field">
      <label for={emailId}>
        Email Address <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <span id={emailHintId} class="hint">Format: you@example.com</span>
      <input
        type="email"
        id={emailId}
        name="EMAIL"
        required
        autocomplete="email"
        aria-describedby={emailHintId}
        data-error={emailErrorId}
        placeholder="you@example.com"
      />
      <div id={emailErrorId} class="error-msg">
        <span role="img" aria-label="Error">❌</span> Enter an email address in the format you@example.com.
      </div>
    </div>

    <div class="field">
      <label for={fnameId}>First Name</label>
      <span class="hint">Optional — so I can say hello</span>
      <input
        type="text"
        id={fnameId}
        name="FNAME"
        autocomplete="given-name"
        placeholder="Your first name"
      />
    </div>
  </div>

  <!-- Mailchimp bot honeypot -->
  <div class="honeypot" aria-hidden="true">
    <input type="text" name={SITE.mailchimp.honeypotName} tabindex="-1" value="" />
  </div>

  <div class="form-footer">
    <button type="submit" name="subscribe" class="btn btn-primary">
      Join the Newsletter
    </button>
    <p class="privacy-note">
      Exclusive updates, release dates, and subscriber-only content. Unsubscribe anytime.
    </p>
  </div>
</form>

<style>
  .newsletter-form {
    width: 100%;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
  }

  label {
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }

  .required-mark {
    color: var(--accent-gold);
  }

  .hint {
    display: block;
    font-size: 0.82rem;
    margin-bottom: 0.4rem;
    opacity: 0.78;
  }

  input[type='email'],
  input[type='text'] {
    width: 100%;
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 1rem;
    border: 1px solid var(--border-dark);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .newsletter-form--dark input[type='email'],
  .newsletter-form--dark input[type='text'] {
    background-color: var(--bg-night);
    color: var(--text-light);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .newsletter-form--light input[type='email'],
  .newsletter-form--light input[type='text'] {
    background-color: var(--bg-paper);
    color: var(--text-dark);
    border-color: rgba(15, 23, 42, 0.22);
  }

  .error-msg {
    display: none;
    color: #f87171;
    font-size: 0.85rem;
    margin-top: 0.35rem;
  }

  .newsletter-form--light .error-msg {
    color: var(--error-color);
  }

  :is(:user-invalid, .user-invalid-fallback) {
    border-color: var(--error-color) !important;
  }

  .newsletter-form--light :is(:user-invalid, .user-invalid-fallback) {
    background-color: var(--error-bg) !important;
  }

  :is(:user-invalid, .user-invalid-fallback) + .error-msg {
    display: block;
  }

  input:user-valid {
    border-color: var(--success-color) !important;
  }

  .honeypot {
    position: absolute;
    left: -5000px;
  }

  .form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .privacy-note {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.78;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const linkError = (el: HTMLElement, shown: boolean) => {
    const errorId = el.dataset.error;
    if (!errorId) return;
    const ids = (el.getAttribute('aria-describedby') || '')
      .split(/\s+/)
      .filter((id) => id && id !== errorId);
    if (shown) ids.push(errorId);
    if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
    else el.removeAttribute('aria-describedby');
  };

  let announcer = document.querySelector<HTMLDivElement>('[data-form-announcer]');
  if (!announcer) {
    announcer = document.createElement('div');
    announcer.setAttribute('aria-live', 'polite');
    announcer.setAttribute('data-form-announcer', '');
    announcer.classList.add('visually-hidden');
    document.body.append(announcer);
  }

  let announceTimer: ReturnType<typeof setTimeout> | undefined;
  let announcedField: Element | undefined;
  const flagged = new WeakSet<Element>();
  const announced = new WeakSet<Element>();
  const dirtyState = new WeakMap<Element, { hasInteracted: boolean; hasBlurred: boolean }>();
  const supportsUserInvalid = CSS.supports('selector(:user-invalid)');

  const spokenText = (node: HTMLElement) => {
    const copy = node.cloneNode(true) as HTMLElement;
    copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
    copy
      .querySelectorAll('[role="img"][aria-label]')
      .forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
    return (copy.textContent || '').replace(/\s+/g, ' ').trim();
  };

  const announceError = (el: HTMLInputElement) => {
    const errorId = el.dataset.error;
    if (!errorId) return;
    const error = document.getElementById(errorId);
    if (!error || !announcer) return;
    const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
    clearTimeout(announceTimer);
    announcer.textContent = '';
    announcedField = el;
    announceTimer = setTimeout(() => {
      if (announcer) announcer.textContent = label + spokenText(error);
    }, 500);
  };

  const syncAria = (el: EventTarget | null, announce = false) => {
    if (!(el instanceof HTMLInputElement)) return;
    const invalid = supportsUserInvalid
      ? el.matches(':user-invalid')
      : el.classList.contains('user-invalid-fallback');

    if (invalid) {
      if (announce && !announced.has(el)) {
        announceError(el);
        announced.add(el);
      }
      el.setAttribute('aria-invalid', 'true');
      linkError(el, true);
      flagged.add(el);
    } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
      el.setAttribute('aria-invalid', 'false');
      linkError(el, false);
      flagged.delete(el);
      announced.delete(el);
      if (announcedField === el && announcer) {
        clearTimeout(announceTimer);
        announcer.textContent = '';
      }
    }
  };

  document.querySelectorAll<HTMLFormElement>('[data-validated-form]').forEach((form) => {
    form.querySelectorAll<HTMLInputElement>('input[type="email"], input[type="text"]').forEach((el) => {
      syncAria(el);
    });

    form.addEventListener(
      'blur',
      (e) => {
        const target = e.target;
        if (!supportsUserInvalid && target instanceof HTMLInputElement) {
          const state = dirtyState.get(target) || { hasInteracted: false, hasBlurred: false };
          state.hasBlurred = true;
          dirtyState.set(target, state);
          if (state.hasInteracted) {
            target.classList.toggle('user-invalid-fallback', !target.validity.valid);
          }
        }
        syncAria(target, true);
      },
      true
    );

    form.addEventListener('input', (e) => {
      const target = e.target;
      if (!supportsUserInvalid && target instanceof HTMLInputElement) {
        const state = dirtyState.get(target) || { hasInteracted: false, hasBlurred: false };
        state.hasInteracted = true;
        dirtyState.set(target, state);
        if (state.hasBlurred) {
          target.classList.toggle('user-invalid-fallback', !target.validity.valid);
        }
      }
      if (target instanceof HTMLInputElement && target.hasAttribute('aria-invalid')) {
        syncAria(target);
      }
    });

    form.addEventListener(
      'invalid',
      (e) => {
        const target = e.target;
        if (target instanceof HTMLInputElement) {
          if (!supportsUserInvalid) {
            dirtyState.set(target, { hasInteracted: true, hasBlurred: true });
            target.classList.toggle('user-invalid-fallback', !target.validity.valid);
          }
          announced.add(target);
          syncAria(target);
        }
      },
      true
    );
  });
</script>
