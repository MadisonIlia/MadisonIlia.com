---
import { execSync } from 'node:child_process';
import { SITE } from '../data/site';

const currentYear = new Date().getFullYear();
const buildTimeIso = new Date().toISOString();

let buildSha = '';
try {
  buildSha = execSync('git rev-parse --short HEAD', { encoding: 'utf8' }).trim();
} catch {
  buildSha = '';
}
---

<footer class="site-footer section-dark">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">MADISON ILIA</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="/novels.html">Novels</a>
      <a href="/about.html">About</a>
      <a href="/contact.html">Contact</a>
      <a href="/subscribe.html">Newsletter</a>
    </nav>

    <div class="footer-socials" aria-label="Social media">
      {
        SITE.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-pill"
            aria-label={social.name}
          >
            {'icon' in social && social.icon && (
              <img src={social.icon} alt="" width="16" height="16" loading="lazy" class="social-icon" />
            )}
            <span>{social.name}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="container footer-bottom">
    <p id="copyright-line">
      &#169; <span id="copyright-year">{currentYear}</span> {SITE.publisher}
      <span
        id="build-info"
        class="build-info"
        data-build-time={buildTimeIso}
        data-build-sha={buildSha}
        hidden
      ></span>
    </p>
    <p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </div>
</footer>

<script>
  const copyrightLine = document.getElementById('copyright-line');
  const buildInfo = document.getElementById('build-info');

  if (copyrightLine && buildInfo) {
    const iso = buildInfo.dataset.buildTime;
    const sha = buildInfo.dataset.buildSha;
    const formatted = iso ? new Date(iso).toLocaleString() : 'unknown';
    buildInfo.textContent = sha ? ` · Built ${formatted} (${sha})` : ` · Built ${formatted}`;

    copyrightLine.addEventListener('click', (e) => {
      if (e.detail === 3) {
        buildInfo.hidden = !buildInfo.hidden;
      }
    });
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border-dark);
    padding-block: 3rem 2rem;
    color: var(--text-muted-light);
    font-size: 0.92rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: 2rem;
    align-items: start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-dark);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-light);
    margin: 0 0 0.5rem;
  }

  .footer-tagline {
    margin: 0;
    max-width: 34ch;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    text-decoration: none;
    color: var(--text-muted-light);
    width: fit-content;
  }

  .footer-nav a:hover {
    color: var(--accent-gold);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-dark);
    color: var(--text-light);
    font-size: 0.85rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .social-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .social-pill:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .build-info {
    opacity: 0.7;
    font-size: 0.8rem;
  }

  .footer-bottom a {
    color: var(--text-muted-light);
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
